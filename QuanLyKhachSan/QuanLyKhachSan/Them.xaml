<Window x:Class="QuanLyKhachSan.Them"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyKhachSan"
        mc:Ignorable="d"
        Title="Thêm Nhân Viên" Height="450" Width="800">
    <Grid>
        <GroupBox Header="Thêm Nhân Viên"/>
        <Grid Margin="10,20,10,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Content="Mã nhân viên:" Grid.Row="0" Grid.Column="0" Margin="8"/>
            <Label Content="Họ tên:" Grid.Row="1" Grid.Column="0" Margin="8"/>
            <Label Content="Địa chỉ:" Grid.Row="2" Grid.Column="0" Margin="8"/>
            <Label Content="Số điện thoại:" Grid.Row="3" Grid.Column="0" Margin="8"/>
            <Label Content="Email:" Grid.Row="4" Grid.Column="0" Margin="8"/>
            <Label Content="Giới tính:" Grid.Row="5" Grid.Column="0" Margin="8"/>
            <Label Content="Hình thức:" Grid.Row="6" Grid.Column="0" Margin="8"/>
            <Label Content="Bộ phận:" Grid.Row="7" Grid.Column="0" Margin="8"/>
            <TextBox x:Name="txtMaNV" Grid.Row="0" Grid.Column="1" Margin="8"/>
            <TextBox x:Name="txtHoTen" Grid.Row="1" Grid.Column="1" Margin="8"/>
            <TextBox x:Name="txtDiaChi" Grid.Row="2" Grid.Column="1" Margin="8"/>
            <TextBox x:Name="txtSoDienThoai" Grid.Row="3" Grid.Column="1" Margin="8"/>
            <TextBox x:Name="txtEmail" Grid.Row="4" Grid.Column="1" Margin="8"/>
            <StackPanel x:Name="txtGioiTinh" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="10">
                <RadioButton x:Name="rdbNam" Content="Nam" GroupName="GioiTinh"/>
                <RadioButton x:Name="rdbNu" Content="Nữ" GroupName="GioiTinh"/>
            </StackPanel>
            <ComboBox x:Name="txtHinhThuc" Grid.Row="6" Grid.Column="1" Margin="10">
                <ComboBoxItem Content="Chính thức"/>
                <ComboBoxItem Content="Thời vụ"/>
                <ComboBoxItem Content="Thử việc"/>
                <ComboBoxItem Content="Bán thời gian"/>
            </ComboBox>
            <ComboBox x:Name="txtBoPhan" Grid.Row="7" Grid.Column="1" Margin="10">
                <ComboBoxItem Content="Lễ Tân"/>
                <ComboBoxItem Content="Vệ sinh"/>
                <ComboBoxItem Content="Bảo vệ"/>
            </ComboBox>
            <WrapPanel Grid.ColumnSpan="2" Grid.Row="8" HorizontalAlignment="Center">
                <Button Content="Thêm" Width="60" Margin="10" Click="Button_Click_1"></Button>
                <Button Content="Quay lại" Width="60" Margin="10" Click="Button_Click"></Button>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
